# Shared JWT secret between auth-service and attendance-api (base64-encoded >= 32 bytes)
APP_JWT_SECRET=replace_with_base64_secret

# Comma-separated frontend origins allowed by attendance API in prod profile
APP_SECURITY_CORS_ALLOWED_ORIGINS=https://app.cale-erp.com,https://admin.cale-erp.com

# Optional bootstrap values for auth-service
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@cale.local
APP_BOOTSTRAP_ADMIN_PASSWORD=change_me_now
