# Shared JWT secret between auth-service and attendance-api (base64-encoded >= 32 bytes)
APP_JWT_SECRET=replace_with_base64_secret
APP_JWT_ISSUER=cale-auth-service
APP_JWT_AUDIENCE=attendance-app-api

# Comma-separated frontend origins allowed by attendance API in prod profile
APP_SECURITY_CORS_ALLOWED_ORIGINS=https://app.cale-erp.com,https://admin.cale-erp.com
APP_SECURITY_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
APP_SECURITY_CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,Origin
APP_SECURITY_CORS_EXPOSED_HEADERS=Authorization
APP_SECURITY_CORS_ALLOW_CREDENTIALS=true
APP_SECURITY_CORS_MAX_AGE_SECONDS=3600
APP_SECURITY_CORS_ENFORCE_SECURE_POLICY=true
APP_ATTENDANCE_RULES_MAX_RETROACTIVE_MINUTES=720
APP_ATTENDANCE_RULES_MAX_FUTURE_TOLERANCE_SECONDS=0
APP_ATTENDANCE_RULES_DUPLICATE_GUARD_ENABLED=true
APP_ATTENDANCE_RULES_SINGLE_CHECK_IN_PER_DAY=true
APP_ATTENDANCE_RULES_MIN_MINUTES_BETWEEN_CHECK_INS=0
APP_ATTENDANCE_RULES_ENFORCE_DAILY_WINDOW=true
APP_ATTENDANCE_RULES_DAILY_WINDOW_START=04:00
APP_ATTENDANCE_RULES_DAILY_WINDOW_END=23:00
APP_OBSERVABILITY_ENVIRONMENT=prod
APP_OBSERVABILITY_HTTP_ACCESS_LOG_ENABLED=true
APP_OBSERVABILITY_TRACING_ENABLED=true
APP_OBSERVABILITY_TRACING_SAMPLING_PROBABILITY=0.15
APP_OBSERVABILITY_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces
APP_OBSERVABILITY_LOG_LEVEL_ROOT=INFO
APP_OBSERVABILITY_LOG_LEVEL_APP=INFO
APP_OBSERVABILITY_LOG_LEVEL_SPRING=INFO
APP_OBSERVABILITY_LOG_LEVEL_HIBERNATE=WARN

# Optional bootstrap values for auth-service
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@cale.local
APP_BOOTSTRAP_ADMIN_PASSWORD=change_me_now
