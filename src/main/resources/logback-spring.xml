<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="attendance-app"/>
    <springProperty scope="context" name="environment" source="app.observability.environment" defaultValue="dev"/>
    <springProperty scope="context" name="rootLevel" source="app.observability.logs.level.root" defaultValue="INFO"/>
    <springProperty scope="context" name="appLevel" source="app.observability.logs.level.app" defaultValue="INFO"/>
    <springProperty scope="context" name="springLevel" source="app.observability.logs.level.spring" defaultValue="INFO"/>
    <springProperty scope="context" name="hibernateLevel" source="app.observability.logs.level.hibernate" defaultValue="WARN"/>

    <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                    <pattern>yyyy-MM-dd'T'HH:mm:ss.SSS'Z'</pattern>
                    <timeZone>UTC</timeZone>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                          "level":"%level",
                          "logger":"%logger{36}",
                          "thread":"%thread",
                          "message":"%message",
                          "service":"${serviceName}",
                          "environment":"${environment}",
                          "traceId":"%X{traceId:-}",
                          "spanId":"%X{spanId:-}",
                          "requestId":"%X{requestId:-}"
                        }
                    </pattern>
                </pattern>
                <arguments/>
                <stackTrace>
                    <fieldName>stacktrace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

    <logger name="com.example.attendance_app" level="${appLevel}"/>
    <logger name="org.springframework" level="${springLevel}"/>
    <logger name="org.hibernate" level="${hibernateLevel}"/>

    <root level="${rootLevel}">
        <appender-ref ref="JSON_CONSOLE"/>
    </root>
</configuration>
